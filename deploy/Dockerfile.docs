FROM node:22-alpine AS builder

WORKDIR /app

# Copy package files
COPY website/package*.json ./
RUN npm ci --prefer-offline --no-audit

# Copy website source and built static assets
COPY website/ ./

# Run production build
RUN npm run build

# Production runtime stage: Ultra-light static server with Caddy
FROM caddy:2-alpine

COPY --from=builder /app/build /usr/share/caddy

RUN printf ':80 {\n    root * /usr/share/caddy\n    encode gzip zstd\n    file_server\n    try_files {path} {path}/ /404.html\n}\n' > /etc/caddy/Caddyfile

EXPOSE 80

CMD ["caddy", "run", "--config", "/etc/caddy/Caddyfile", "--adapter", "caddyfile"]
