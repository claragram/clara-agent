# ==============================================================================
# Claraship Production Environment Variables
# Copy to .env.production on the server and populate with secret values.
# ==============================================================================

# Public Domain & ACME (Let's Encrypt / ZeroSSL)
DOMAIN=claraship.com
ACME_EMAIL=admin@claraship.com

# Core AI Model Provider (OpenRouter recommended for DeepSeek-V4 Flash / Sonnet / etc.)
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
CLARA_DEFAULT_MODEL=deepseek/deepseek-v4-flash

# Alternative direct model keys (optional)
# ANTHROPIC_API_KEY=sk-ant-api03-...
# OPENAI_API_KEY=sk-proj-...
# GEMINI_API_KEY=AIzaSy...

# Optional Web Search & Extractor APIs
# EXA_API_KEY=
# FIRECRAWL_API_KEY=

# Optional Communication Channels (bots will respond directly in these apps)
# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=
# SLACK_BOT_TOKEN=xoxb-...
# SLACK_APP_TOKEN=xapp-...

# Security & Dashboard Access
# Optional static session token. If left blank, Clara generates one on startup.
CLARA_SESSION_TOKEN=
